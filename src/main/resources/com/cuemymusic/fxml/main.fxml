<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!--
  Layout a 3 colonne con barra di riproduzione in basso.

  Note di layout:
  - le tre colonne usano percentWidth con larghezze minime, cosi' la finestra
    resta leggibile anche stretta e il ridimensionamento e' proporzionale;
  - ogni lista ha minHeight, altrimenti con una sola riga collassa a zero
    e il pannello diventa irraggiungibile;
  - le liste sono scrollabili di default (ListView incorpora un VirtualFlow).
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cuemymusic.MainController" fx:id="rootPane"
            styleClass="root-pane" prefWidth="1180.0" prefHeight="720.0">

    <top>
        <VBox spacing="10.0" styleClass="top-bar">
            <padding>
                <Insets top="12.0" right="18.0" bottom="12.0" left="18.0"/>
            </padding>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="CueMyMusic" styleClass="app-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" prefWidth="260.0" styleClass="input-field"/>
                <Button text="Apri cartella…" onAction="#handleChooseFolder" styleClass="action-button, primary-button"/>
                <Button text="Aggiorna" onAction="#handleRefresh" styleClass="action-button"/>
            </HBox>
            <HBox spacing="12.0" alignment="CENTER_LEFT">
                <ProgressBar fx:id="loadingIndicator" visible="false"/>
                <Label fx:id="statusLabel" styleClass="status-label" HBox.hgrow="ALWAYS"/>
                <Label fx:id="libraryCountLabel" styleClass="muted-label"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <GridPane hgap="14.0" vgap="14.0" fx:id="contentGrid">
            <padding>
                <Insets top="0.0" right="18.0" bottom="0.0" left="18.0"/>
            </padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="26" minWidth="200" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="48" minWidth="300" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="26" minWidth="200" hgrow="ALWAYS"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- LEFT: playlist + libreria locale -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="12.0">
                <children>
                    <VBox styleClass="panel" VBox.vgrow="ALWAYS" spacing="8.0">
                        <Label text="Playlist" styleClass="section-title"/>
                        <ListView fx:id="playlistsList" VBox.vgrow="ALWAYS" minHeight="120.0"
                                  styleClass="minimal-list"/>
                        <Label text="Le playlist verranno qui" styleClass="muted-label" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="panel" VBox.vgrow="ALWAYS" spacing="8.0">
                        <Label text="Libreria locale" styleClass="section-title"/>
                        <ListView fx:id="localFilesList" VBox.vgrow="ALWAYS" minHeight="160.0"
                                  styleClass="minimal-list"/>
                    </VBox>
                </children>
            </VBox>

            <!-- CENTER: ascoltati di recente + azioni -->
            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="12.0">
                <VBox styleClass="panel" VBox.vgrow="ALWAYS" spacing="8.0">
                    <Label text="Ascoltati di recente" styleClass="section-title"/>
                    <ListView fx:id="recentSongsList" VBox.vgrow="ALWAYS" minHeight="160.0"
                              styleClass="minimal-list"/>
                </VBox>
                <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="action-row">
                    <Button fx:id="addToQueueButton" text="Aggiungi alla coda"
                            onAction="#handleAddToQueue" styleClass="action-button"/>
                    <Button text="Svuota coda" onAction="#handleClearQueue" styleClass="action-button"/>
                </HBox>
                <!-- Stato vuoto: compare solo quando la libreria non contiene brani. -->
                <VBox fx:id="emptyStateBox" styleClass="panel, empty-state" spacing="8.0" visible="false">
                    <Label text="La libreria e' vuota" styleClass="section-title"/>
                    <Label text="Scegli una cartella con i tuoi brani per iniziare. I file"
                           wrapText="true" styleClass="muted-label"/>
                    <Button text="Apri cartella…" onAction="#handleChooseFolder"
                            styleClass="action-button, primary-button"/>
                </VBox>
            </VBox>

            <!-- RIGHT: coda di riproduzione -->
            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="panel" spacing="8.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="Coda" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="queueCountLabel" styleClass="muted-label"/>
                </HBox>
                <ListView fx:id="queueList" VBox.vgrow="ALWAYS" minHeight="200.0"
                          styleClass="minimal-list, queue-list"/>
            </VBox>
        </GridPane>
    </center>

    <!-- Barra di riproduzione: copre tutta la larghezza, resta ancorata in basso. -->
    <bottom>
        <VBox styleClass="waybar" spacing="10.0">
            <padding>
                <Insets top="14.0" right="20.0" bottom="14.0" left="20.0"/>
            </padding>

            <HBox spacing="16.0" alignment="CENTER_LEFT">
                <Region styleClass="cover-art" prefWidth="64.0" prefHeight="64.0"
                        minWidth="64.0" minHeight="64.0"/>
                <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="2.0">
                    <Label fx:id="currentSongLabel" styleClass="song-title" textTruncationPriority="ELLIPSIS"/>
                    <Label fx:id="currentArtistLabel" styleClass="song-artist"/>
                    <Label fx:id="currentDetailLabel" styleClass="muted-label"/>
                </VBox>
                <Button fx:id="fullscreenButton" text="⛶" onAction="#toggleFullscreen"
                        styleClass="control-button" focusTraversable="false"/>
            </HBox>

            <HBox spacing="12.0" alignment="CENTER">
                <Label fx:id="elapsedLabel" text="0:00" styleClass="time-label" minWidth="52.0"/>
                <Slider fx:id="progressBar" HBox.hgrow="ALWAYS" styleClass="progress-bar"/>
                <Label fx:id="durationLabel" text="--:--" styleClass="time-label" minWidth="52.0"/>
            </HBox>

            <HBox spacing="16.0" alignment="CENTER">
                <Button fx:id="previousButton" text="⏮" onAction="#previousTrack"
                        styleClass="control-button"/>
                <Button fx:id="playPauseButton" text="▶" onAction="#togglePlayPause"
                        styleClass="control-button, play-button"/>
                <Button fx:id="nextButton" text="⏭" onAction="#nextTrack" styleClass="control-button"/>
                <Button fx:id="muteButton" text="🔊" onAction="#toggleMute"
                        styleClass="control-button, volume-button"/>
                <Slider fx:id="volumeSlider" prefWidth="130.0" max="1.0" styleClass="volume-slider"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
